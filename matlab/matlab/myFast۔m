function corners = myFAST(img, threshold, N)
    % img: gray image, threshold: jaise 20, N: 12
    [h,w] = size(img);
    corners = [];
    % 16 points ka circle offset (x,y)
    circle = [0 3; 1 3; 2 2; 3 1; 3 0; 3 -1; 2 -2; 1 -3; ...
              0 -3; -1 -3; -2 -2; -3 -1; -3 0; -3 1; -2 2; -1 3];
    
    for y = 4:h-3
        for x = 4:w-3
            c = double(img(y,x));
            countBright = 0; countDark = 0;
            isCorner = false;
            
            % Tumhara wala check: c + threshold
            for i = 1:16
                p = double(img(y+circle(i,2), x+circle(i,1)));
                if p > c + threshold
                    countBright = countBright + 1;
                else
                    countBright = 0;
                end
                if p < c - threshold
                    countDark = countDark + 1;
                else
                    countDark = 0;
                end
                if countBright >= N || countDark >= N
                    isCorner = true; break;
                end
            end
            if isCorner
                corners = [corners; x y];
            end
        end
    end
end
